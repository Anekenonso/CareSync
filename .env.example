# ==============================================================================
# Open Agent Hackathon 2026 - Environment Configuration
# ==============================================================================

# Zetaris (Data Layer)
# Reached locally at localhost:8888 or inside Docker via host.docker.internal
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (Primary AI Provider)
# Connects to hosted NVIDIA Nemotron endpoints configured in Nightshift Providers tab
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Runtime Configuration
# Set SAMPLE_MODE=true for offline judging without live Zetaris/Nightshift instances
SAMPLE_MODE=true
LOG_LEVEL=INFO
PORT=8000
